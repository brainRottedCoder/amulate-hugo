# Portfolio demo login (default on). Set to false to require Firebase email/password.
# NEXT_PUBLIC_DEMO_AUTH=true

# Server data store. Default is memory (works on Vercel). Set firestore only with Admin SDK.
# BUDGET_STORE=memory
# FIRESTORE_SERVER=true

# Firebase Configuration
# Copy this file to .env.local and replace with your Firebase project credentials

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Fireworks API Configuration (Get from https://app.fireworks.ai/settings/users/api-keys)
# Model: accounts/fireworks/models/minimax-m3
FIREWORKS_API_KEY=your_fireworks_api_key_here
# Optional overrides:
# FIREWORKS_MODEL=accounts/fireworks/models/minimax-m3
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Phase 2–4 feature flags (omit or set true; use "false" to disable)
# HUGO_TOOL_CALLING=true
# HUGO_MEMORY=true
# HUGO_RAG=true

# Optional Upstash Redis (falls back to in-memory cache)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Phase 5 — environment / observability / budgets
# VOLTWAY_ENV=local|staging|production
# STAGING_EMAIL_ALLOWLIST=safe@voltway.test,qa@voltway.test
# SENTRY_DSN=
# TENANT_MONTHLY_TOKEN_LIMIT=2000000
# BUDGET_STORE=firestore

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Voltway Procurement <your_email@gmail.com>

# Optional E2E (Playwright)
# E2E_EMAIL=you@voltway.com
# E2E_PASSWORD=your_password
